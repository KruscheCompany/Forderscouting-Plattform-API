{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "tag"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "approved"],
      "default": "approved"
    },
    "source": {
      "type": "enumeration",
      "enum": ["manual", "ai"],
      "default": "manual"
    },
    "projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "mappedBy": "tags"
    },
    "fundings": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::funding.funding",
      "mappedBy": "tags"
    },
    "read_notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::read-notification.read-notification",
      "private": true,
      "mappedBy": "tag_pending"
    }
  }
}
