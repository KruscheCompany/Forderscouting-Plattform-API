# Server Configuration
HOST=
PORT=

# Which deployed environment this is: local, dev, stage, or prod.
# Gates outbound email (see src/extensions/email/strapi-server.js):
#   prod  -> sends normally
#   stage -> only admin-role recipients get mail, everyone else is dropped
#   anything else (dev/local/unset) -> all mail is redirected to a safe test inbox
APP_ENV=

# Application Security
APP_KEYS=
JWT_SECRET=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# Database Configuration
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PORT=
DATABASE_SSL=
DATABASE_NAME=

# Backend URLs
BACKEND_URL_LOCAL=
RESET_PWD_PAGE=
VORPRUEFUNG_REVIEW_PAGE=

# scripts/locations/*.js (HTTP + JWT against Strapi's REST API) — set per
# environment you run those scripts against.
STRAPI_API_URL_LOCAL=
STRAPI_API_URL_DEV=
STRAPI_API_URL_STAGE=
STRAPI_API_URL_PROD=
TRANSLATE_EMAIL_AUTH_LOCAL=
TRANSLATE_EMAIL_PASS_LOCAL=
TRANSLATE_EMAIL_AUTH_DEV=
TRANSLATE_EMAIL_PASS_DEV=
TRANSLATE_EMAIL_AUTH_STAGE=
TRANSLATE_EMAIL_PASS_STAGE=
TRANSLATE_EMAIL_AUTH_PROD=
TRANSLATE_EMAIL_PASS_PROD=

# scripts/translations/sync.js and scripts/translations/schema-introspect.js
# (direct MySQL connection, per environment). "local" falls back to the
# generic DATABASE_* vars above if these aren't set.
DATABASE_HOST_LOCAL=
DATABASE_PORT_LOCAL=
DATABASE_USERNAME_LOCAL=
DATABASE_PASSWORD_LOCAL=
DATABASE_NAME_LOCAL=
DATABASE_SSL_LOCAL=
DATABASE_HOST_DEV=
DATABASE_PORT_DEV=
DATABASE_USERNAME_DEV=
DATABASE_PASSWORD_DEV=
DATABASE_NAME_DEV=
DATABASE_SSL_DEV=
DATABASE_HOST_STAGE=
DATABASE_PORT_STAGE=
DATABASE_USERNAME_STAGE=
DATABASE_PASSWORD_STAGE=
DATABASE_NAME_STAGE=
DATABASE_SSL_STAGE=
DATABASE_HOST_PROD=
DATABASE_PORT_PROD=
DATABASE_USERNAME_PROD=
DATABASE_PASSWORD_PROD=
DATABASE_NAME_PROD=
DATABASE_SSL_PROD=

# Error Tracking
SENTRY_DSN=

# Email Configuration
EMAIL_AUTH=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
DEF_FROM=
DEF_REPLYTO=

# Emailing Center
EC_DEF_FROM=

# Teams Integration
TEAMS_HOOK_URL=
TEAMS_HOOK_PASS=
