{
  "kind": "collectionType",
  "collectionName": "tag_decisions",
  "info": {
    "singularName": "tag-decision",
    "pluralName": "tag-decisions",
    "displayName": "tag decision",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
