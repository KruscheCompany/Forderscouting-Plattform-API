    },
    "tag": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tag.tag"
    },
    "submittedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "read_notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::read-notification.read-notification",
      "private": true,
      "mappedBy": "tag_decision"
    }
  }
}
